FROM docker.io/devkitpro/devkita64@sha256:1fc388c3a0d34bd2045a6dadcb1020e069d5f876a187fd705de14b4440c00282

LABEL org.opencontainers.image.source="https://github.com/chiaki-ng/dockerfiles"
LABEL org.opencontainers.image.description="devkitA64 updated to GCC 16 with the Switch build tools"

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        autoconf automake build-essential bzip2 ca-certificates cmake curl git jq \
        libtool make ninja-build patch perl pkg-config python3 rsync xz-utils zstd \
    && rm -rf /var/lib/apt/lists/*

RUN dkp-pacman -Syu --noconfirm \
    && dkp-pacman -S --noconfirm --needed \
        devkitA64 \
        dkp-toolchain-vars \
        switch-cmake \
        switch-dev \
        switch-pkg-config \
    && dkp-pacman -Scc --noconfirm \
    && /opt/devkitpro/devkitA64/bin/aarch64-none-elf-gcc -dumpversion | grep -q '^16\.'

ENV PATH=/opt/devkitpro/devkitA64/bin:${PATH}
